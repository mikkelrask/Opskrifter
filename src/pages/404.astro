---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ikke fundet" description="Siden blev ikke fundet.">
  <main class="wrap">
    <div class="recipe-header" style="text-align: center;">
      <p class="recipe-header__no">404</p>
      <h1>Siden findes ikke i kataloget</h1>
      <p class="recipe-header__desc" style="margin-left: auto; margin-right: auto;">
        Den opskrift eller side, du leder efter, kunne ikke findes.
      </p>
      <p><a class="recipe-header__back" href="/">← Tilbage til forsiden</a></p>
    </div>
  </main>
</Layout>
