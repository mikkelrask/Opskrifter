---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GodMode from '../components/GodMode.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeTag?: string;
}

const { title, description = 'Et personligt opskriftsbibliotek.', activeTag } = Astro.props;
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} — Open Sauce</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;500;600&family=Karla:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header activeTag={activeTag} />
    <slot />
    <Footer />
    {import.meta.env.DEV && <GodMode />}
  </body>
</html>
